### PHẦN 2: LƯU ĐỒ TRẠNG THÁI HỆ THỐNG (STATE MACHINE FOR DEVS)

Dưới đây là sơ đồ Mermaid.js mô tả chi tiết luồng xử lý dữ liệu và sự tương tác giữa Bác sĩ Lâm sàng (Clinical Doc), Bác sĩ Kiểm soát Nhiễm khuẩn (IP Doc) và Động cơ suy luận (Rule Engine) của phần mềm:

```mermaid
stateDiagram-v2
    [*] --> State_0_Admission : ADT Nhập viện (HD 1)
    
    state State_0_Admission {
        [*] --> Patient_Enrolled
        Patient_Enrolled --> Device_Linked : Đặt Dụng cụ (Central Line / Foley / Máy thở)
    }

    state State_1_Monitoring {
        Device_Linked --> Compliance_Check : Giám sát tuân thủ (CLIP/Hand Hygiene)
        Compliance_Check --> Longitudinal_Data : Cập nhật sinh hiệu, PEEP/FiO2 hàng ngày
    }

    State_0_Admission --> State_2_Trigger_Engine : Xuất hiện Tín hiệu cảnh báo
    State_1_Monitoring --> State_2_Trigger_Engine : Xuất hiện Tín hiệu cảnh báo

    state State_2_Trigger_Engine {
        [*] --> Evaluator
        Evaluator --> Candidate_Created : 1. Cấy vi sinh (+) (LIS)
        Evaluator --> Candidate_Created : 2. Kháng sinh mới sau HD 3 (Dược)
        Evaluator --> Candidate_Created : 3. Đờm mủ / X-quang xấu (Lâm sàng)
        Evaluator --> Candidate_Created : 4. Suy giảm hô hấp (Longitudinal)
    }

    State_2_Trigger_Engine --> State_3_Investigation : Kích hoạt "Phiếu Sàng Lọc/Điều Tra" (Index Date)
    
    state State_3_Investigation {
        [*] --> Calculate_IWP : Phần mềm tự động tạo IWP (Index Date ± 3 ngày)
        Calculate_IWP --> Guided_Entry : Form hướng dẫn nhập liệu động theo IWP
        
        state Guided_Entry {
            [*] --> Clinical_Doc_Input : BS Lâm sàng điền triệu chứng trong IWP
            Clinical_Doc_Input --> IP_Doc_Review : BS KSNK rà soát chéo bệnh án giấy/HIS
        }
    }

    State_3_Investigation --> State_4_Rule_Engine : IP Doc nhấn "Chạy chẩn đoán"
    
    state State_4_Rule_Engine {
        [*] --> Check_Criteria : Khớp các mệnh đề Logic Boolean (SUTI, LCBI, VAE, SSI)
        Check_Criteria --> Calculate_DOE : Tìm ngày xuất hiện yếu tố đầu tiên trong IWP
        Calculate_DOE --> POA_HAI_Filter : DOE <= Day 2 (POA) / DOE >= Day 3 (HAI)
        POA_HAI_Filter --> Device_Association_Check : Dụng cụ đặt > 2 ngày & hiện diện tại DOE/DOE-1?
        Device_Association_Check --> RIT_Check : DOE có rơi vào RIT 14 ngày của ca cũ không?
        RIT_Check --> Secondary_BSI_Check : Chạy màng lọc SBAP (14-17 ngày) cho cấy máu (+)
    }

    State_4_Rule_Engine --> State_5_Case_Closure : Kết xuất kết quả cuối cùng

    state State_5_Case_Closure {
        [*] --> Confirm_By_IP : Chuyên gia KSNK đưa ra quyết định cuối cùng (IP Determination)
        Confirm_By_IP --> Save_And_Lock : Đóng ca bệnh & Khóa dữ liệu
        Save_And_Lock --> Generate_Report : Xuất mẫu phiếu phân tích & Tính SIR/SUR/Rate
    }
    State_5_Case_Closure --> [*]
```

