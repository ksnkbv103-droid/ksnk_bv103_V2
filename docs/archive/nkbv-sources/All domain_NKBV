        Evaluator --&gt; Candidate_Created : 1. Cấy vi sinh (+) (LIS)
        Evaluator --&gt; Candidate_Created : 2. Kháng sinh mới sau HD 3 (Dược)
        Evaluator --&gt; Candidate_Created : 3. Đờm mủ / X-quang xấu (Lâm sàng)
        Evaluator --&gt; Candidate_Created : 4. Suy giảm hô hấp (Longitudinal)
    }

    State_2_Trigger_Engine --&gt; State_3_Investigation : Kích hoạt "Phiếu Sàng Lọc/Điều Tra" (Index Date)

    state State_3_Investigation {
        [*] --&gt; Calculate_IWP : Phần mềm tự động tạo IWP (Index Date ± 3 ngày)
        Calculate_IWP --&gt; Guided_Entry : Form hướng dẫn nhập liệu động theo IWP

        state Guided_Entry {
            [*] --&gt; Clinical_Doc_Input : BS Lâm sàng điền triệu chứng trong IWP
            Clinical_Doc_Input --&gt; IP_Doc_Review : BS KSNK rà soát chéo bệnh án giấy/HIS
        }
    }

    State_3_Investigation --&gt; State_4_Rule_Engine : IP Doc nhấn "Chạy chẩn đoán"

    state State_4_Rule_Engine {
        [*] --&gt; Check_Criteria : Khớp các mệnh đề Logic Boolean (SUTI, LCBI, VAE, SSI)
        Check_Criteria --&gt; Calculate_DOE : Tìm ngày xuất hiện yếu tố đầu tiên trong IWP
        Calculate_DOE --&gt; POA_HAI_Filter : DOE &lt;= Day 2 (POA) / DOE &gt;= Day 3 (HAI)
        POA_HAI_Filter --&gt; Device_Association_Check : Dụng cụ đặt &gt; 2 ngày &amp; hiện diện tại DOE/DOE-1?
        Device_Association_Check --&gt; RIT_Check : DOE có rơi vào RIT 14 ngày của ca cũ không?
        RIT_Check --&gt; Secondary_BSI_Check : Chạy màng lọc SBAP (14-17 ngày) cho cấy máu (+)
    }

    State_4_Rule_Engine --&gt; State_5_Case_Closure : Kết xuất kết quả cuối cùng

    state State_5_Case_Closure {
        [*] --&gt; Confirm_By_IP : Chuyên gia KSNK đưa ra quyết định cuối cùng (IP Determination)
        Confirm_By_IP --&gt; Save_And_Lock : Đóng ca bệnh &amp; Khóa dữ liệu
        Save_And_Lock --&gt; Generate_Report : Xuất mẫu phiếu phân tích &amp; Tính SIR/SUR/Rate
    }
    State_5_Case_Closure --&gt; [*]

